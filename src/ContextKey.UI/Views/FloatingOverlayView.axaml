<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ContextKey.UI.ViewModels"
        xmlns:models="using:ContextKey.Core.Models"
        x:Class="ContextKey.UI.Views.FloatingOverlayView"
        x:DataType="vm:FloatingOverlayViewModel"
        Title="ContextKey"
        Width="380"
        Height="320"
        MinHeight="180"
        CanResize="False"
        SystemDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        Background="#F7F7F7">
    <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="8">
        <Grid RowDefinitions="Auto,*" RowSpacing="6">
            <TextBox x:Name="QueryBox"
                     Watermark="search snippets and windows"
                     MinHeight="28"
                     Text="{Binding Query}" />
            <ListBox x:Name="ResultList"
                     Grid.Row="1"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SearchResult">
                        <StackPanel Spacing="1" Margin="0,2">
                            <TextBlock Text="{Binding Label}" FontSize="13" />
                            <TextBlock Text="{Binding Value}"
                                       FontSize="11"
                                       Opacity="0.65"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
